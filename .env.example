# ── Media Downloader · example environment ──────────────────────────────
# Copy to .env and adjust. Never commit real secrets.

# ── Backend (FastAPI) ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. No "*" in production.
CORS_ORIGINS=http://localhost:3000

# Safety / abuse limits
MAX_URL_LENGTH=2048
MAX_DOWNLOAD_BYTES=2147483648      # 2 GiB per download
MAX_DURATION_SECONDS=14400         # 4 hours
RATE_LIMIT_INFO_PER_MIN=20         # /api/v1/media/info requests per IP / min
RATE_LIMIT_DOWNLOAD_PER_MIN=5      # /api/v1/media/download requests per IP / min
REQUEST_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
APP_VERSION=1.0.0

# PO Token Provider (bgutil HTTP server)
# Default is http://127.0.0.1:4416 (bundled in container or host).
# In docker-compose or container sidecar, set to http://pot-provider:4416 if using separate service.
POT_PROVIDER_URL=http://127.0.0.1:4416

# Optional upstream proxy (e.g. http://user:pass@proxy.example.com:8080)
PROXY_URL=

# Optional Netscape cookies (base64 or raw string). Use only if required.
YOUTUBE_COOKIES=

# ── Frontend (Next.js) ────────────────────────────────────────────────────
# Public base URL of the FastAPI backend.
NEXT_PUBLIC_API_URL=http://localhost:8000
