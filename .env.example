# Media Downloader configuration
# Copy this file to .env and keep .env out of version control.

# Backend: comma-separated origins allowed to call the API.
# Use only your real frontend origin(s) in production; do not use *.
CORS_ORIGINS=http://localhost:3000

# Resource and abuse limits
MAX_URL_LENGTH=2048
MAX_DOWNLOAD_BYTES=2147483648
MAX_DURATION_SECONDS=14400
RATE_LIMIT_INFO_PER_MIN=20
RATE_LIMIT_DOWNLOAD_PER_MIN=5
REQUEST_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO
APP_VERSION=1.0.0

# Internal PO-token provider address. Docker starts the bundled provider here.
POT_PROVIDER_URL=http://127.0.0.1:4416

# Optional server-side credentials. Leave blank unless you explicitly need them.
# Never commit, log, or expose these values through NEXT_PUBLIC_* variables.
PROXY_URL=
YOUTUBE_COOKIES=

# Frontend: public API base URL (this value is embedded in the client build).
NEXT_PUBLIC_API_URL=http://localhost:8000
